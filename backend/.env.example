# --- AcePair API configuration ---
# Copy to .env for local runs. In Dokploy, set these in the env panel.
# Do not commit a real .env — only this template.

# Async SQLAlchemy URL (asyncpg driver). In compose this is built from
# POSTGRES_PASSWORD; set it directly for a standalone API run.
DATABASE_URL=postgresql+asyncpg://acepair@localhost:5432/acepair

# Signs JWT access tokens. Provide a long random string (required in production).
JWT_SECRET=

# Comma-separated allowed browser origins, or * for any.
CORS_ORIGINS=*

# Seed a demo club (slug: riverside) on first boot, and the login password for it.
SEED_DEMO_DATA=true
SEED_DEMO_PASSWORD=

ENVIRONMENT=production
