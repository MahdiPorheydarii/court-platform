# --- AcePair API configuration ---
# Copy to .env for local runs. In Dokploy, set these as service env vars.

# Async SQLAlchemy URL (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://acepair:acepair@db:5432/acepair

# Secret used to sign JWT access tokens. CHANGE THIS in production.
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated allowed browser origins, or * for any.
CORS_ORIGINS=*

# Seed a demo club (slug: riverside) on first boot so the app isn't empty.
SEED_DEMO_DATA=true

ENVIRONMENT=production
