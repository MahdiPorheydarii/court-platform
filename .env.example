# AcePair deployment config. Copy to .env and fill in real values, or paste
# these into the Dokploy env panel. The .env file is gitignored — never commit
# real secrets.

# --- Required secrets ---
# Database password (any strong random string).
POSTGRES_PASSWORD=

# Signs login tokens (long random string). Generate e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- Recommended ---
# The API's public URL, baked into the web build so the browser knows where to
# call. Leave empty to ship the web app in demo-data showcase mode.
API_PUBLIC_URL=

# The web app's public origin, for CORS (e.g. https://acepair.example). "*" for any.
CORS_ORIGINS=*

# Password for the seeded demo accounts (club "riverside", alex@riverside.club).
# Leave empty to generate a random one per boot (no public demo login).
SEED_DEMO_PASSWORD=
